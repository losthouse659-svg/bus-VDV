datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model BusTelemetry {
  id          Int      @id @default(autoincrement())
  vehicleId   String
  soc         Float
  status      String
  temperature Float?
  createdAt   DateTime @default(now())
}
